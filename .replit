modules = ["nodejs-24", "python-3.11"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bot 2026 — Dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bot 2026 — Discord"

[[workflows.workflow]]
name = "Bot 2026 — Dashboard"
mode = "sequential"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python web/app.py"
cwd = "./bot/botdiscordoff"
waitForPort = 5000
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "5000"

[[workflows.workflow]]
name = "Bot 2026 — Discord"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python main.py"
cwd = "./bot/botdiscordoff"

[agent]
stack = "PYTHON"
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "zlib"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23183
externalPort = 3000

[userenv]

[userenv.shared]
DISCORD_CLIENT_ID = "1157699815833088001"
FLASK_SECRET_KEY = "miaouscle-secret-2025"
OWNER_PASSWORD = " matix-off@"
PAYPAL_MODE = "live"
SYNC_COMMANDS = "false"

[deployment]
deploymentTarget = "cloudrun"
