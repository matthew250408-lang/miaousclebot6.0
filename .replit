modules = ["nodejs-24", "python-3.11"]

[workflows]

[[workflows.workflow]]
name = "Bot 2026 — Dashboard"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python web/app.py"
cwd = "./bot/botdiscordoff"
waitForPort = 5000
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "5000"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Bot 2026 — Discord"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python main.py"
cwd = "./bot/botdiscordoff"

[[workflows.workflow]]
name = "artifacts/api-server: Bot Web Dashboard"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/bot/botdiscordoff && bash start.sh"
cwd = "./artifacts/api-server"
waitForPort = 5000
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "5000"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/dashboard: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/dashboard"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/dashboard run dev"
cwd = "./artifacts/dashboard"
waitForPort = 23183
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "23183"
BASE_PATH = "/react-dash/"

[agent]
stack = "PYTHON"
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "zlib"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23183
externalPort = 3000

[userenv]

[userenv.shared]
DISCORD_CLIENT_ID = "1157699815833088001"
FLASK_SECRET_KEY = "miaouscle-secret-2025"
OWNER_PASSWORD = " matix-off@"
PAYPAL_MODE = "live"
SYNC_COMMANDS = "false"

[deployment]
deploymentTarget = "cloudrun"
